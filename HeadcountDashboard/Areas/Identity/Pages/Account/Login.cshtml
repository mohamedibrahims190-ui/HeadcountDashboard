@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="login-page">

    <div class="login-card">

        <!-- =====================================================
             BRAND
             ===================================================== -->

        <div class="login-brand">

            <div class="login-brand-title">
                Live Headcount Board
            </div>

            <div class="login-brand-subtitle">
                Workforce Management System
            </div>

        </div>


        <!-- =====================================================
             LOGIN HEADING
             ===================================================== -->

        <h1 class="login-title">
            Welcome back
        </h1>

        <p class="login-description">
            Sign in to access the headcount dashboard.
        </p>


        <!-- =====================================================
             LOGIN FORM
             ===================================================== -->

        <form id="account"
              method="post">

            <!-- Validation summary -->

            <div asp-validation-summary="ModelOnly"
                 class="text-danger login-validation"
                 role="alert">
            </div>


            <!-- =================================================
                 EMAIL
                 ================================================= -->

            <div class="login-field">

                <label asp-for="Input.Email">
                    Email
                </label>

                <input asp-for="Input.Email"
                       class="form-control"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="name@example.com" />

                <span asp-validation-for="Input.Email"
                      class="text-danger">
                </span>

            </div>


            <!-- =================================================
                 PASSWORD
                 ================================================= -->

            <div class="login-field">

                <label asp-for="Input.Password">
                    Password
                </label>

                <input asp-for="Input.Password"
                       class="form-control"
                       autocomplete="current-password"
                       aria-required="true"
                       placeholder="Enter your password" />

                <span asp-validation-for="Input.Password"
                      class="text-danger">
                </span>

            </div>


            <!-- =================================================
                 REMEMBER ME
                 ================================================= -->

            <div class="login-remember">

                <input class="form-check-input"
                       asp-for="Input.RememberMe" />

                <label asp-for="Input.RememberMe">
                    @Html.DisplayNameFor(
                        m => m.Input.RememberMe
                    )
                </label>

            </div>


            <!-- =================================================
                 LOGIN BUTTON
                 ================================================= -->

            <button id="login-submit"
                    type="submit"
                    class="login-submit">

                Log in

            </button>


            <!-- =================================================
                 IDENTITY LINKS
                 ================================================= -->

            <div class="login-links">

                <p>
                    <a id="forgot-password"
                       asp-page="./ForgotPassword">
                        Forgot your password?
                    </a>
                </p>

                <p>
                    <a id="resend-confirmation"
                       asp-page="./ResendEmailConfirmation">
                        Resend email confirmation
                    </a>
                </p>

            </div>

        </form>


        <!-- =====================================================
             FOOTER
             ===================================================== -->

        <div class="login-footer">
            Authorized access only.
            Headcount data is restricted to permitted users.
        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}