@model HeadcountDashboard.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Headcount Dashboard";
}

<!-- =========================================================
     DASHBOARD HEADER
     ========================================================= -->
<div class="upm-root">
<div class="upm-header">

    <div class="upm-header-top">

        <!-- Application title -->
        <div class="upm-brand">

            <div class="upm-wordmark">
                <div class="line2">
                    Live Headcount Board
                </div>
            </div>

        </div>

        <!-- Current time and business date -->
            <div class="upm-header-actions">

                <div class="upm-clock">

                    <div class="time" id="upmClockTime">
                        --:--:--
                    </div>

                    <div class="date" id="upmClockDate">
                        @Model.BusinessDate.ToString("dd MMM yyyy")
                    </div>

                </div>


                <div class="upm-user">

                    <span class="upm-user-name">
                        @User.Identity?.Name
                    </span>

                    @if (User.IsInRole("Admin"))
                    {
                        <span class="upm-user-role">
                            Admin
                        </span>
                    }

                    <form asp-area="Identity"
                          asp-page="/Account/Logout"
                          method="post">

                        <button type="submit"
                                class="upm-logout-btn">
                            Logout
                        </button>

                    </form>

                </div>

            </div>

    </div>


    <!-- =====================================================
         TOTAL HEADCOUNT SUMMARY
         ===================================================== -->

    <div class="upm-total-strip">

            <div>

                <div class="upm-total-label">
                    @Model.CurrentShift Shift Total, All Departments
                </div>

                <div class="upm-total-num">

                    @if (Model.CurrentShift == "A")
                    {
                        @Model.Departments.Sum(d => d.AShiftCount)
                    }
                    else if (Model.CurrentShift == "B")
                    {
                        @Model.Departments.Sum(d => d.BShiftCount)
                    }
                    else if (Model.CurrentShift == "C")
                    {
                        @Model.Departments.Sum(d => d.CShiftCount)
                    }

                </div>

            </div>


        <!-- Shift summary -->

            <div class="upm-shift-pills">

                <!-- A Shift -->
                <div class="upm-shift-pill @(Model.CurrentShift == "A" ? "active" : "")">

                    <span class="dot"></span>

                    A Shift

                    <b>
                        @Model.AShiftTotal
                    </b>

                </div>


                <!-- B Shift -->
                <div class="upm-shift-pill @(Model.CurrentShift == "B" ? "active" : "")">

                    <span class="dot"></span>

                    B Shift

                    <b>
                        @Model.BShiftTotal
                    </b>

                </div>


                <!-- C Shift -->
                <div class="upm-shift-pill @(Model.CurrentShift == "C" ? "active" : "")">

                    <span class="dot"></span>

                    C Shift

                    <b>
                        @Model.CShiftTotal
                    </b>

                </div>

            </div>

    </div>

</div>


<!-- =========================================================
     MAIN BODY
     ========================================================= -->

<div class="upm-body">


    <!-- =====================================================
         SUCCESS / ERROR MESSAGES
         ===================================================== -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }


    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }


    <!-- =====================================================
         DATE SELECTION

         IMPORTANT:
         This is a GET form.

         It calls:
         DashboardController.Index(DateTime? date)

         It is NOT the Save form.
         ===================================================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2>
                Headcount Dashboard
            </h2>

            <p class="text-muted mb-0">
                Daily workforce headcount
            </p>

        </div>


        <!-- DATE FORM -->

            <form method="get"
                  asp-controller="Dashboard"
                  asp-action="Index">

                <div class="input-group">

                    <input type="date"
                           name="date"
                           value="@Model.BusinessDate.ToString("yyyy-MM-dd")"
                           class="form-control"
                           onchange="this.form.submit();" />

                </div>

            </form>

    </div>


    <!-- =====================================================
         SAVE FORM START

         Everything that must be submitted to:

         DashboardController.Save()

         belongs inside this form.
         ===================================================== -->

    <form asp-controller="Dashboard"
          asp-action="Save"
          method="post">

        <!-- CSRF protection -->
        @Html.AntiForgeryToken()


        <!-- Selected business date -->

        <input type="hidden"
               name="businessDate"
               value="@Model.BusinessDate.ToString("yyyy-MM-dd")" />


        <!-- =================================================
             HIDDEN DEPARTMENT DATA

             The visible UI uses cards instead of a table.

             However, DashboardViewModel expects:

             Departments[0]
             Departments[1]
             Departments[2]
             ...

             These hidden fields preserve the complete
             department collection when the form is submitted.
             ================================================= -->
        @for (int i = 0; i < Model.Departments.Count; i++)
        {
            <input type="hidden"
                   name="Departments[@i].DepartmentId"
                   value="@Model.Departments[i].DepartmentId" />

            <input type="hidden"
                   name="Departments[@i].DepartmentName"
                   value="@Model.Departments[i].DepartmentName" />

            <input type="hidden"
                   name="Departments[@i].DepartmentCode"
                   value="@Model.Departments[i].DepartmentCode" />


            <!--
                These three hidden fields contain the actual
                values that will be submitted to Save().

                JavaScript updates these when the user changes
                the values in the Update panel.
            -->

            <input type="hidden"
                   name="Departments[@i].AShiftCount"
                   id="hiddenA_@i"
                   value="@Model.Departments[i].AShiftCount" />

            <input type="hidden"
                   name="Departments[@i].BShiftCount"
                   id="hiddenB_@i"
                   value="@Model.Departments[i].BShiftCount" />

            <input type="hidden"
                   name="Departments[@i].CShiftCount"
                   id="hiddenC_@i"
                   value="@Model.Departments[i].CShiftCount" />
        }


        <!-- =================================================
             DEPARTMENTS
             ================================================= -->

        <div class="upm-section-title">
            Departments
        </div>


        <div class="upm-grid">

            @for (int i = 0; i < Model.Departments.Count; i++)
            {
                var department = Model.Departments[i];

                <div class="upm-card">

                    <!-- Department name + total -->

                    <div class="upm-card-top">

                        <div>

                            <div class="upm-card-name">
                                @department.DepartmentName
                            </div>

                            <div class="upm-card-code">
                                @department.DepartmentCode
                            </div>

                        </div>


                        <!-- Department total -->

                        <div class="upm-card-total">
                            @department.Total
                        </div>

                    </div>


                    <!-- =================================================
                         SHIFT COUNTS
                         ================================================= -->

                    <div class="upm-shift-row">


                        <!-- A SHIFT -->

                        <div class="upm-shift-box">

                            <div class="lbl">
                                A Shift
                            </div>

                            <div class="val">
                                @department.AShiftCount
                            </div>

                        </div>


                        <!-- B SHIFT -->

                        <div class="upm-shift-box">

                            <div class="lbl">
                                B Shift
                            </div>

                            <div class="val">
                                @department.BShiftCount
                            </div>

                        </div>


                        <!-- C SHIFT -->

                        <div class="upm-shift-box">

                            <div class="lbl">
                                C Shift
                            </div>

                            <div class="val">
                                @department.CShiftCount
                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         LAST UPDATED INFORMATION
                         ================================================= -->
                    @if (department.UpdatedAt.HasValue)
                    {
                        <div class="upm-card-updated">

                            <span class="pulse"></span>

                            <span>

                                Updated by:
                                @department.UpdatedBy

                                <br />

                                    @TimeZoneInfo.ConvertTimeFromUtc(
                                         DateTime.SpecifyKind(
                                             department.UpdatedAt.Value,
                                             DateTimeKind.Utc
                                         ),
                                         TimeZoneInfo.FindSystemTimeZoneById("Asia/Dubai")
                                     ).ToString("dd MMM yyyy, hh:mm tt")

                            </span>

                        </div>
                    }

                </div>
            }

        </div>


        <!-- =====================================================
             UPDATE YOUR COUNT
             ===================================================== -->

        <div class="upm-section-title">
            Update your count
        </div>


        <div class="upm-panel">


            <!-- =================================================
                 DEPARTMENT SELECTION
                 ================================================= -->

            <div class="upm-panel-row">
                    <div class="upm-active-shift-banner">

                        <span>●</span>

                        <span>
                            <b>@Model.CurrentShift Shift</b>
                            is currently active.
                            You can update @Model.CurrentShift Shift only.
                        </span>

                    </div>
                <div class="upm-field">

                    <label for="departmentSelect">
                        Department
                    </label>

                    <select id="departmentSelect"
                            class="form-select">

                        @for (int i = 0; i < Model.Departments.Count; i++)
                        {
                            <option value="@i">

                                @Model.Departments[i].DepartmentName

                            </option>
                        }

                    </select>

                </div>

            </div>


            <!-- =================================================
                 SHIFT INPUTS
                 ================================================= -->

                <div class="upm-panel-row">

                    <!-- A SHIFT -->
                    <div class="upm-field">

                        <label for="aShiftInput">
                            A Shift
                        </label>

                        <input type="number"
                               id="aShiftInput"
                               min="0"
                               max="1000"
                               class="form-control"
                        @(Model.CurrentShift != "A" || !Model.IsEditableDate ? "readonly" : "") />

                    </div>


                    <!-- B SHIFT -->
                    <div class="upm-field">

                        <label for="bShiftInput">
                            B Shift
                        </label>

                        <input type="number"
                               id="bShiftInput"
                               min="0"
                               max="1000"
                               class="form-control"
                        @(Model.CurrentShift != "B" || !Model.IsEditableDate ? "readonly" : "") />

                    </div>


                    <!-- C SHIFT -->
                    <div class="upm-field">

                        <label for="cShiftInput">
                            C Shift
                        </label>

                        <input type="number"
                               id="cShiftInput"
                               min="0"
                               max="1000"
                               class="form-control"
                        @(Model.CurrentShift != "C" || !Model.IsEditableDate ? "readonly" : "") />

                    </div>

                </div>


            <!-- =================================================
                 SAVE BUTTON

                 Only Admin users can save.
                 ================================================= -->
            @if (User.IsInRole("Admin"))
            {
                <button type="submit"
                        class="upm-save-btn">

                    Save count

                </button>
            }


            <!-- Additional information -->

            <div class="upm-footer-note">

                Only Admin users can update headcount.
                Changes are saved for the selected business date.

            </div>

        </div>


    </form>
    <!-- =====================================================
         SAVE FORM END
         ================================================= -->


</div>
</div>

<!-- =========================================================
     JAVASCRIPT
     ========================================================= -->

<script>

    /*
     * Convert the server-side department collection into
     * JavaScript data.
     *
     * This allows the Update panel to display the current
     * values when a department is selected.
     */

    const departments =
        @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
        Model.Departments
        )
        );


    /*
     * Get references to the UI controls.
     */

    const departmentSelect =
        document.getElementById("departmentSelect");

    const aShiftInput =
        document.getElementById("aShiftInput");

    const bShiftInput =
        document.getElementById("bShiftInput");

    const cShiftInput =
        document.getElementById("cShiftInput");


    /*
     * Load the selected department's current values
     * into the Update panel.
     */

    function loadDepartment(index) {
        const department = departments[index];

        if (!department) {
            return;
        }

        aShiftInput.value =
            department.AShiftCount;

        bShiftInput.value =
            department.BShiftCount;

        cShiftInput.value =
            department.CShiftCount;
    }


    /*
     * Update the hidden fields that will actually be
     * submitted to DashboardController.Save().
     */

    function updateHiddenFields() {
        const index =
            parseInt(departmentSelect.value);


        /*
         * Find the hidden fields for the selected department.
         */

        const hiddenA =
            document.getElementById(`hiddenA_${index}`);

        const hiddenB =
            document.getElementById(`hiddenB_${index}`);

        const hiddenC =
            document.getElementById(`hiddenC_${index}`);


        /*
         * Update their values.
         */

        if (hiddenA) {
            hiddenA.value =
                aShiftInput.value;
        }

        if (hiddenB) {
            hiddenB.value =
                bShiftInput.value;
        }

        if (hiddenC) {
            hiddenC.value =
                cShiftInput.value;
        }
    }


    /*
     * When the user changes the department,
     * load that department's current values.
     */

    departmentSelect.addEventListener(
        "change",
        function() {
            const index =
                parseInt(this.value);

            loadDepartment(index);
        }
    );


    /*
     * When the user changes A/B/C values,
     * immediately update the corresponding hidden
     * fields.
     */

    aShiftInput.addEventListener(
        "input",
        updateHiddenFields
    );

    bShiftInput.addEventListener(
        "input",
        updateHiddenFields
    );

    cShiftInput.addEventListener(
        "input",
        updateHiddenFields
    );


    /*
     * Load the first department when the page opens.
     */

    if (departments.length > 0) {
        loadDepartment(0);
    }


    /*
     * ========================================================
     * LIVE CLOCK
     * ========================================================
     *
     * This updates the clock displayed in the header.
     */

    function updateClock() {
        const now = new Date();


        /*
         * Time
         */

        const time =
            now.toLocaleTimeString(
                "en-US",
                {
                    hour12: false
                }
            );


        /*
         * Date
         */

        const date =
            now.toLocaleDateString(
                "en-GB",
                {
                    day: "2-digit",
                    month: "short",
                    year: "numeric"
                }
            );


        const clockTime =
            document.getElementById(
                "upmClockTime"
            );

        const clockDate =
            document.getElementById(
                "upmClockDate"
            );


        if (clockTime) {
            clockTime.textContent =
                time;
        }

        /*
         * Keep the server-selected business date
         * in the header instead of replacing it.
         *
         * Therefore we intentionally do not update
         * clockDate here.
         */
    }


    /*
     * Start clock.
     */

    updateClock();

    setInterval(
        updateClock,
        1000
    );

</script>